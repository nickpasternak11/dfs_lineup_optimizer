# Copy to .env before running `make run`. Docker Compose loads .env automatically.
POSTGRES_DB=dfs
POSTGRES_USER=dfs
POSTGRES_PASSWORD=change-me

# Optional overrides. DATABASE_URL, when set, wins over the parts above.
# DATABASE_URL=postgresql+psycopg://dfs:change-me@dfs-postgres:5432/dfs
# DB_POOL_SIZE=5
# DB_ECHO=false
